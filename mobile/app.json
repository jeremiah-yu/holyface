{
  "expo": {
    "name": "Holy Face Student",
    "slug": "holyface-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "holyface",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "school.holyface.student",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Log in and unlock your Holy Face student account with Face ID."
      }
    },
    "newArchEnabled": false,
    "android": {
      "package": "school.holyface.student",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "USE_BIOMETRIC", "USE_FINGERPRINT"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b1f3a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1f3a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Holy Face Student uses photos only to read class notes you upload.",
          "cameraPermission": "Holy Face Student uses the camera so you can photograph class notes."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://holyface.infinityfreeapp.com/api/public"
    }
  }
}
