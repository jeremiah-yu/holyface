{
  "expo": {
    "name": "Holy Face Student",
    "slug": "holyface-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "holyface",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "school.holyface.student",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your Holy Face student ID with Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1f3a"
      },
      "package": "school.holyface.student"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1f3a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Holy Face Student uses photos only to read class notes you upload.",
          "cameraPermission": "Holy Face Student uses the camera so you can photograph class notes."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.254.103:8089"
    }
  }
}
